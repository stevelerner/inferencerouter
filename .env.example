# InferenceRouter Configuration

# Local inference (on-prem) — Ollama-compatible endpoint
LOCAL_BASE="http://localhost:11434/v1"
LOCAL_MODEL="llama2:70b"           # any Ollama model (use your preferred base model)
LOCAL_FIM="starcoder:1.3b"         # fill-in-middle autocomplete (small, FIM-capable)
LOCAL_EMBED="nomic-embed-text"     # embeddings (never leaves the building)
LOCAL_CTX_TOKENS="65536"           # usable input budget (roughly half OLLAMA_NUM_CTX)

# Cloud inference — Anthropic Claude API
# Leave ANTHROPIC_API_KEY unset or empty to run on-prem only; cloud routing fails safe to local
ANTHROPIC_API_KEY=""
CLOUD_BASE="https://api.anthropic.com/v1"
CLOUD_MODEL="claude-opus-5"        # any current Claude model

# Cloud pricing — update these if rates change
CLOUD_IN_PER_MTOK="5.0"            # $ per million input tokens
CLOUD_OUT_PER_MTOK="25.0"          # $ per million output tokens

# Routing behavior
RESIDENCY="strict"                 # "strict" (code/paths are sensitive) or "secrets-only"
COMPLEX_CHARS="700"                # char threshold for complexity detection
CTX_SAFETY="0.85"                  # leave this % of local context for the response

# Debugging
ROUTER_DEBUG="0"                   # set to "1" to print classification decisions
